[Unit]
Description=GameBench Studio (Game-Gen)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shixiaoqiang
Group=shixiaoqiang
WorkingDirectory=/data/shixiaoqiang/game_gen
Environment=HOME=/home/shixiaoqiang
Environment=PATH=/data/shixiaoqiang/.local/node-v24.19.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/data/shixiaoqiang/.local/node-v24.19.0/bin/node /data/shixiaoqiang/game_gen/dist/src/cli.js serve --hostname 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
